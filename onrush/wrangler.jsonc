// Reference dashboard and startup API. M0 remains live until an authorized deploy.
// ACCESS_AUD must be supplied for this hostname's Access application before
// deployment. Missing Access configuration fails closed, including static assets.
{
  "name": "onrush-awareness",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/site",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://awareness.onrushdata.com",
    "NODE_ENV": "production",
    "ACCESS_TEAM_DOMAIN": "https://cannonwest.cloudflareaccess.com"
  },
  "routes": [{ "pattern": "awareness.onrushdata.com", "custom_domain": true }]
}
