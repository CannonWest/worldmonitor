{
  "name": "onrush-awareness",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node build-worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser-startup.mjs",
