# Applied by the Workers static-assets layer. The holding page loads no
# scripts of its own; script-src admits only the zone's Cloudflare Web
# Analytics beacon, injected on the live host as on the other onrushdata.com
# sites. Not indexed: the host sits behind Cloudflare Access anyway.
/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=()
